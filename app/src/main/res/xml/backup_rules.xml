<?xml version="1.0" encoding="utf-8"?>
<!-- Privacidad 100% local: no subir reglas ni historial al respaldo automático en la nube -->
<full-backup-content>
    <exclude domain="file" path="." />
    <exclude domain="sharedpref" path="." />
    <exclude domain="database" path="." />
</full-backup-content>
